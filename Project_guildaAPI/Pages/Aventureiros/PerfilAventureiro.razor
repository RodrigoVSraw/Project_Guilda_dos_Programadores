@page "/Aventureiro/Perfil/{Id:int}"
@using AventureiroDATA.DAO
@using SistemaDeGuildas.Models
@inject AventureiroDAO AventureiroDao

<div>
	@if (heroi != null)
	{
		<h1>Ficha de Aventureiro: @heroi.Nome</h1>
        <p>Classe: @heroi.ClasseDeCombate</p>
        <p>Nível: @heroi.Nivel</p>
		<p>Experiência:: @heroi.Experiencia XP</p>
		<p>Ouro: @heroi.Ouro</p>

		<h2>Atributos</h2>
		<p>HP: @heroi.Vida</p>
		<p>Força: @heroi.Forca</p>
		<p>Mana: @heroi.Mana</p>	
		<p>Stamina: @heroi.Energia</p>
		<p>Habilidade Especial: @heroi.HabilidadeEspecial</p>
        
        @if (heroi.Guilda != null)
        {
			<a href="/Guilda/Painel/@heroi.Guilda.Id"><p>Estandarte: @heroi.Guilda.Nome (Nível @heroi.Guilda.Nivel)</p></a>
        }
        else
        {
            <p>Estandarte: Lobo Solitário</p>
        }
    }
	else
	{
		<p>Carregando...</p>
	}
</div>

@code {
	[Parameter]
	public int Id { get; set; }

	private Aventureiro heroi;

	protected override async Task OnInitializedAsync()
	{
		heroi = await AventureiroDao.BuscarAventureiroPorIdAsync(Id);
	}
}
