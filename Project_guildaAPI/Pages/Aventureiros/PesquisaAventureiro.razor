@page "/Aventureiros/Pesquisa"
@using SistemaDeGuildas.Models
@using AventureiroDATA.DAO
@inject AventureiroDAO AventureiroDao

<div>
    <h2>Salão dos Heróis</h2>

    <div>
        <input type="text"
               @bind="pesquisaAventureiro"
               @bind:event="oninput"
               placeholder="Buscar aventureiro por nome..."/>
    </div>

    <div>
        
        @foreach (var aventureiro in aventureirosFiltrados)
        {
            <a href="/Aventureiro/Perfil/@aventureiro.Id">
                <div class="aventureiro-card">
                    <h3>@aventureiro.Nome</h3>
                    <p>Classe: @aventureiro.ClasseDeCombate</p>
                    <p>Nível: @aventureiro.Nivel</p>
                    <p>Experiência: @aventureiro.Experiencia XP</p>
                </div>
            </a>
        }

        @if (!aventureirosFiltrados.Any())
        {
            <p>Nenhum herói encontrado com o nome "@pesquisaAventureiro".</p>
        }
    </div>
</div>

@code {

	Aventureiro aventureiroBuscado;
	List<Aventureiro> listaAventureiros = new List<Aventureiro>();

	string pesquisaAventureiro = "";

	IEnumerable<Aventureiro> aventureirosFiltrados
	{
		get
		{
			if (string.IsNullOrWhiteSpace(pesquisaAventureiro))
				return listaAventureiros;

			return listaAventureiros.Where(a => a.Nome.Contains(pesquisaAventureiro, StringComparison.OrdinalIgnoreCase));
		}
	}

	protected override async Task OnInitializedAsync()
	{
		listaAventureiros = await AventureiroDao.BuscarAventureirosAsync();
	}
}
