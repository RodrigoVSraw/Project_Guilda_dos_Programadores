@page "/Guilda/Painel/{Id:int}"
@using SistemaDeGuildas.Models
@using GuildasDATA.DAO
@inject GuildaDAO GuildaDao

<div>
		<div class="guilda-card">
			<h3>@painelG.Nome</h3>
			<p>Nível: @painelG.Nivel</p>
			<a href="/Guilda/Membros"><p>Quantidade de Membros: @painelG.Membros.Count</p></a>
			<p>Descrição: @painelG.Descricao</p>
			<p>Nível Requerido: @painelG.NivelRequerido</p>	
		</div>
</div>

@code {
