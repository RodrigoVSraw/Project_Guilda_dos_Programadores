@page "/Guilda/Membros/{Id:int}"
@using SistemaDeGuildas.Models
@using SistemaDeGuildas.Services

@inject GuildaS GuildaService
@inject IJSRuntime JSRuntime
@rendermode InteractiveServer

<PageTitle>Membros da Guilda</PageTitle>

@if (guildaAtual == null)
{
    <div class="text-center mt-5">
        <h3 class="texto-destaque-ouro">Aguarde... Buscando os registros da guilda...</h3>
    </div>
}
else
{
    <Banner Titulo="Quadro de Membros" Descricao="@($"Guilda {guildaAtual.Nome}")" />

    <div class="container main-content mt-4 container-membros">

        <div class="search-bar-container">
            <input type="text"
                   @bind="pesquisaMembro"
                   @bind:event="oninput"
                   class="form-control input-pesquisa"
                   placeholder="Buscar membro por nome..." />
        </div>

        @if (!string.IsNullOrEmpty(mensagemAviso))
        {
            <div class="text-center mb-4 mensagem-aviso">
                <strong>Atenção:</strong> @mensagemAviso
            </div>
        }
        @if (!string.IsNullOrEmpty(mensagemSucesso))
        {
            <div class="text-center mb-4 mensagem-sucesso">
                <strong>Sucesso:</strong> @mensagemSucesso
            </div>
        }

        @if (guildaAtual.Membros == null || !guildaAtual.Membros.Any())
        {
            <div class="text-center mt-5">
                <h3 class="texto-destaque-ouro">Esta guilda ainda não possui membros alistados.</h3>
            </div>
        }
        else
        {
            <div class="membros-grid">
                @foreach (var membro in membrosFiltrados)
                {
                    <div class="membro-card">
                        <div class="membro-info">
                            <div class="membro-icone">
                                @(membro.Cargo == "Líder" ? "👑" : "🛡️")
                            </div>
                            <h3>@membro.Nome</h3>
                            <p><strong>Cargo:</strong> @membro.Cargo</p>
                            <p><strong>Classe:</strong> @membro.ClasseDeCombate</p>
                            <p><strong>Nível:</strong> @membro.Nivel</p>
                        </div>

                        <div class="membro-acoes">
                            <a href="/Aventureiros/Perfil/@membro.Id" class="btn-perfil">
                                👁️ Inspecionar
                            </a>

                            <button class="btn-expulsar" @onclick="() => RemoverMembro(membro)">
                                ❌ Expulsar
                            </button>
                        </div>
                    </div>
                }
            </div>

            @if (!membrosFiltrados.Any())
            {
                <div class="text-center mt-4">
                    <p class="texto-nenhum-resultado">
                        Nenhum membro encontrado com o nome "<strong>@pesquisaMembro</strong>".
                    </p>
                </div>
            }
        }
    </div>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private Guilda guildaAtual;
    private string pesquisaMembro = "";

    private string mensagemAviso = "";
    private string mensagemSucesso = "";

    private IEnumerable<Aventureiro> membrosFiltrados
    {
        get
        {
            if (guildaAtual?.Membros == null)
                return new List<Aventureiro>();

            if (string.IsNullOrWhiteSpace(pesquisaMembro))
                return guildaAtual.Membros;

            return guildaAtual.Membros.Where(m => m.Nome.Contains(pesquisaMembro, StringComparison.OrdinalIgnoreCase));
        }
    }

    protected override async Task OnInitializedAsync()
    {
        guildaAtual = await GuildaService.ObterGuildaPorIdAsync(Id);
    }

    private async Task RemoverMembro(Aventureiro aventureiro)
    {
        mensagemAviso = "";
        mensagemSucesso = "";

        bool confirmado = await JSRuntime.InvokeAsync<bool>("confirm", $"Tem certeza que deseja expulsar {aventureiro.Nome} da guilda?");

        if (!confirmado) return;

        try
        {
            await GuildaService.RemoverAventureiro(aventureiro.Id);

            guildaAtual.Membros.Remove(aventureiro);
            mensagemSucesso = $"{aventureiro.Nome} foi expulso(a) da guilda com sucesso!";
        }
        catch (InvalidOperationException ex)
        {
            mensagemAviso = ex.Message;
        }
        catch (Exception ex)
        {
            mensagemAviso = $"Erro no sistema: {ex.Message}";
        }
    }
}