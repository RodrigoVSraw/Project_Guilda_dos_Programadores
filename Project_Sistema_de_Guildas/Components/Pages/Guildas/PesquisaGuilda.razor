@page "/Guilda/Pesquisa"
@using SistemaDeGuildas.Models
@using SistemaDeGuildas.Services

@inject IJSRuntime JSRuntime
@inject GuildaS GuildaService
@rendermode InteractiveServer

<PageTitle>Taverna de Guildas</PageTitle>

<Banner Titulo="Taverna de Alistamento" Descricao="Explore os registros de guildas já criadas e se aliste" />

<div>
    <div class="search-bar-container">
        <input type="text"
               @bind="pesquisaGuilda"
               @bind:event="oninput"
               class="form-control input-pesquisa"
               placeholder="Buscar guilda por nome..." />

        <a href="/Guilda/Cadastro" class="btn-acao-lateral">
            ➕ Fundar Guilda
        </a>
    </div>

    @if (!string.IsNullOrEmpty(mensagemAviso))
    {
        <div class="text-center mb-4 mensagem-aviso">
            <strong>Atenção:</strong> @mensagemAviso
        </div>
    }
    @if (!string.IsNullOrEmpty(mensagemSucesso))
    {
        <div class="text-center mb-4 mensagem-sucesso">
            <strong>Sucesso:</strong> @mensagemSucesso
        </div>
    }

    @if (listaGuildas == null)
    {
        <div class="text-center mt-5">
            <h3 class="texto-destaque-ouro">Aguarde... Os mensageiros estão buscando os registos das guildas.</h3>
        </div>
    }
    else if (listaGuildas.Count == 0)
    {
        <div class="text-center mt-5">
            <h3 class="texto-destaque-ouro">Ainda não existem Guildas fundadas neste reino.</h3>
        </div>
    }
    else
    {
        <div class="features-grid">
            @foreach (var guilda in guildasFiltradas)
            {
                <div class="feature-box cartao-guilda">

                    <button class="btn-deletar-cartao" title="Desfazer Guilda"
                            @onclick="() => DeletarGuilda(guilda.Id)"
                            @onclick:stopPropagation="true">
                        ❌
                    </button>

                    <a href="/Guilda/Painel/@guilda.Id" class="link-cartao-guilda">

                        <div class="feature-icon">🚩</div>
                        <h3>@guilda.Nome</h3>

                        <p><strong>Nível da Guilda:</strong> @guilda.Nivel</p>
                        <p><strong>Nível Requerido:</strong> @guilda.NivelRequerido</p>

                        <p class="descricao-guilda">
                            "@guilda.Descricao"
                        </p>

                        <p><strong>Membros:</strong> @(guilda.Membros?.Count ?? 0)</p>
                    </a>
                </div>
            }
        </div>

        @if (!guildasFiltradas.Any())
        {
            <div class="text-center mt-4">
                <p class="texto-nenhum-resultado">
                    Nenhuma guilda encontrada com o nome "<strong>@pesquisaGuilda</strong>".
                </p>
            </div>
        }
    }
</div>

@code {

    List<Guilda> listaGuildas;
    string pesquisaGuilda = "";

    private string mensagemAviso = "";
    private string mensagemSucesso = "";

    private IEnumerable<Guilda> guildasFiltradas
    {
        get
        {
            if (string.IsNullOrWhiteSpace(pesquisaGuilda))
                return listaGuildas;

            return listaGuildas.Where(g => g.Nome.Contains(pesquisaGuilda, StringComparison.OrdinalIgnoreCase));
        }
    }

    protected override async Task OnInitializedAsync()
    {
        listaGuildas = await GuildaService.ObterGuildasAsync();
    }

    private async Task DeletarGuilda(int id)
    {
        mensagemAviso = "";
        mensagemSucesso = "";

        bool confirmado = await JSRuntime.InvokeAsync<bool>("confirm", "Tem certeza que deseja queimar o estandarte e desfazer esta guilda?");

        if (confirmado)
        {
            try
            {
                await GuildaService.ExcluirGuildaAsync(id);

                listaGuildas.RemoveAll(g => g.Id == id);
                mensagemSucesso = "O estandarte foi queimado e a guilda desfeita permanentemente!";
                StateHasChanged();
            }
            catch (Exception ex)
            {
                mensagemAviso = $"A guilda resistiu à exclusão: {ex.Message}";
            }
        }
    }
}