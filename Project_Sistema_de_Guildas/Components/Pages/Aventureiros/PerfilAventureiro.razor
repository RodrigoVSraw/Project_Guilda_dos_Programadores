@page "/Aventureiros/Perfil/{Id:int}"
@using SistemaDeGuildas.Services
@using SistemaDeGuildas.Models
@inject AventureiroS AventureiroService

<div>
    @if (heroi == null)
    {
        <div class="text-center mt-5">
            <h3 style="color: var(--ouro-velho);">Aguarde... Consultando os grandes pergaminhos...</h3>
        </div>
    }
    else
    {  
        <Banner Titulo="@heroi.Nome" Descricao="@($"Nível {heroi.Nivel} - {heroi.ClasseDeCombate}")" />

        <div class="container main-content mt-4" style="max-width: 900px; margin: 0 auto; padding-bottom: 40px;">
        
            <div class="perfil-card">
            
                <div class="perfil-header">
                    <h2>Ficha Oficial do Aventureiro</h2>
                
                    @if (heroi.Guilda != null)
                    {
                        <div class="guilda-badge">
                            <span>🛡️ Estandarte:</span>
                            <a href="/Guilda/Painel/@heroi.Guilda.Id" class="guilda-link">@heroi.Guilda.Nome (Nível @heroi.Guilda.Nivel)</a>
                        </div>
                    }
                    else
                    {
                        <div class="guilda-badge solitario">
                            <span>🐺 Lobo Solitário</span>
                        </div>
                    }
                </div>

                <div class="perfil-body">
                    <div class="status-geral">
                        <p><strong>Experiência:</strong> @heroi.Experiencia XP</p>
                        <p><strong>Bolsa de Ouro:</strong> <span style="color: #b88d3b; font-weight: bold;">@heroi.Ouro 💰</span></p>
                        <p><strong>Habilidade Especial:</strong> 🌟 @heroi.HabilidadeEspecial</p>
                    </div>

                    <h3 class="atributos-title">Atributos de Combate</h3>
                
                    <div class="atributos-grid">
                        <div class="atributo-box hp">
                            <span class="icone">❤️</span>
                            <span class="nome">Vida</span>
                            <span class="valor">@heroi.Vida</span>
                        </div>
                        <div class="atributo-box forca">
                            <span class="icone">⚔️</span>
                            <span class="nome">Força</span>
                            <span class="valor">@heroi.Forca</span>
                        </div>
                        <div class="atributo-box mana">
                            <span class="icone">💧</span>
                            <span class="nome">Mana</span>
                            <span class="valor">@heroi.Mana</span>
                        </div>
                        <div class="atributo-box stamina">
                            <span class="icone">⚡</span>
                            <span class="nome">Energia</span>
                            <span class="valor">@heroi.Energia</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
	[Parameter]
	public int Id { get; set; }

	private Aventureiro heroi;

	protected override async Task OnInitializedAsync()
	{
		heroi = await AventureiroService.ObterAventureiroPorIdAsync(Id);
	}
}
