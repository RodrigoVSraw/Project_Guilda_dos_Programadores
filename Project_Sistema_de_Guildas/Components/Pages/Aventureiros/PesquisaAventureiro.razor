@page "/Aventureiros/Pesquisa"
@using SistemaDeGuildas.Models
@using SistemaDeGuildas.Services
@inject AventureiroS AventureiroService
@inject IJSRuntime JSRuntime
@rendermode InteractiveServer

<PageTitle>O Salão dos Heróis</PageTitle>

<Banner Titulo="O Salão dos Heróis" Descricao="Explore os registros dos aventureiros que se alistaram no estabelecimento!" />

<div>

    
    <div class="search-bar-container">
        <input type="text"
                @bind="pesquisaAventureiro"
                @bind:event="oninput"
                class="form-control input-pesquisa"
                placeholder="Buscar aventureiro por nome..." />

        <a href="/Aventureiro/Cadastro" class="btn-acao-lateral">
            ➕ Alistar Herói
        </a>
    </div>

    @if (listaAventureiros == null)
    {
        <div class="text-center mt-5">
            <h3 style="color: var(--ouro-velho);">Aguarde... Os mensageiros estão buscando os registos na guilda.</h3>
        </div>
    }
    else if (listaAventureiros.Count == 0)
    {
        <div class="text-center mt-5">
            <h3 style="color: var(--ouro-velho);">Nenhum aventureiro encontrou coragem para se alistar ainda.</h3>
        </div>
    }
    else
    {
        <div class="features-grid">
            @foreach (var aventureiro in aventureirosFiltrados)
            {
                <div class="feature-box" style="position:relative">
                    <button class="btn-deletar-cartao" title="Banir Herói" @onclick="() => DeletarAventureiro(aventureiro.Id)">
                        ❌
                    </button>
                    <a href="/Aventureiros/Perfil/@aventureiro.Id" style="text-decoration: none;">     
                        <div class="feature-icon">🛡️</div>
                        <h3>@aventureiro.Nome</h3>
                        <p><strong>Classe:</strong> @aventureiro.ClasseDeCombate</p>
                        <p><strong>Nível:</strong> @aventureiro.Nivel</p>
                        <p><strong>Ouro:</strong> $@aventureiro.Ouro</p>
                    </a>
                </div>
            }
        </div>

        @if (!aventureirosFiltrados.Any())
        {
            <div class="text-center mt-4">
                <p style="color: var(--pergaminho); font-size: 1.2rem;">
                    Nenhum herói encontrado com o nome "<strong>@pesquisaAventureiro</strong>".
                </p>
            </div>
        }
    }
</div>

@code {
    private List<Aventureiro> listaAventureiros;
    private string pesquisaAventureiro = "";

    private IEnumerable<Aventureiro> aventureirosFiltrados
    {
        get
        {
            if (string.IsNullOrWhiteSpace(pesquisaAventureiro))
                return listaAventureiros;

            return listaAventureiros.Where(a => a.Nome.Contains(pesquisaAventureiro, StringComparison.OrdinalIgnoreCase));
        }
    }

    protected override async Task OnInitializedAsync()
    {
        listaAventureiros = await AventureiroService.ListarAventureirosAsync();
    }

    private async Task DeletarAventureiro(int id)
    {
        bool confirmado = await JSRuntime.InvokeAsync<bool>("confirm", "Tem certeza que deseja banir este aventureiro da taverna permanentemente?");

        if (confirmado)
        {
            try
            {
                await AventureiroService.ExcluirAventureiroAsync(id);

                listaAventureiros.RemoveAll(a => a.Id == id);
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Erro ao excluir: {ex.Message}");
            }
        }
    }
}