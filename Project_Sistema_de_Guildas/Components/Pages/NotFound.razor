@page "/not-found"

<PageTitle>404 - Não Encontrado</PageTitle>

<div class="container text-center mt-5">
    <div class="row">
        <div class="col">
            <h1 class="display-1 fw-bold text-danger">404</h1>
            <h2 class="mb-4">Oops! Destino Desconhecido</h2>
            <p class="lead text-muted mb-4">
                A guilda que procura mudou de localização ou a missão que tenta aceder já expirou.
            </p>
            <a href="/" class="btn btn-primary btn-lg">Voltar à Taberna Inicial</a>
        </div>
    </div>
</div>