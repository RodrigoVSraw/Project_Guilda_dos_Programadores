@page "/Missoes/Cadastro"
@using SistemaDeGuildas.Models
@using SistemaDeGuildas.Services

@inject MissaoS MissaoService
@inject NavigationManager NavManager
@rendermode InteractiveServer

<PageTitle>Registro de Contrato</PageTitle>

<Banner Titulo="Quadro de Avisos" Descricao="Preencha um novo contrato de caçada ou resgate para os heróis da região!" />

<div class="container main-content mt-4" style="max-width: 650px; padding-bottom: 50px;">

    <div class="formulario-card">

        @if (mostrarSucesso)
        {
            <div class="mensagem-sucesso text-center">
                <div style="font-size: 4rem; margin-bottom: 15px;">📜🗡️</div>
                <h2 style="color: #2d5a2d; font-family: 'Georgia', serif;">Contrato Publicado!</h2>
                <p style="font-size: 1.2rem; margin-bottom: 25px;">Sua missão foi afixada no Quadro e já pode ser aceita por aventureiros corajosos.</p>

                <a href="/Missoes/Pesquisa" class="btn-taverna btn-sucesso">
                    🍻 Ver Quadro de Missões
                </a>
            </div>
        }
        else
        {
            <div class="text-center mb-4">
                <h2 class="form-titulo">Novo Contrato</h2>
                <p class="form-subtitulo">Descreva o perigo, estabeleça o preço e aguarde os mercenários.</p>
                <div class="divisor-elegante"></div>
            </div>

            <EditForm Model="@modeloFormulario" OnValidSubmit="SalvarMissao" FormName="formCriarMissao">

                <div class="form-group">
                    <label class="form-label">Título da Missão:</label>
                    <InputText @bind-Value="modeloFormulario.Nome" class="form-control input-taverna" placeholder="Ex: Limpar a Caverna dos Goblins..." />
                </div>

                <div class="form-group">
                    <label class="form-label">Descrição e Detalhes:</label>
                    <InputTextArea @bind-Value="modeloFormulario.Descricao" class="form-control input-taverna text-area-taverna" placeholder="Onde fica? O que deve ser feito? Quais são as feras?" rows="4" />
                </div>

                <div style="display: flex; gap: 15px; flex-wrap: wrap;">
                    <div class="form-group" style="flex: 1; min-width: 150px;">
                        <label class="form-label">Recompensa (Ouro 💰):</label>
                        <InputNumber @bind-Value="modeloFormulario.Ouro" class="form-control input-taverna" min="1" />
                    </div>

                    <div class="form-group" style="flex: 1; min-width: 150px;">
                        <label class="form-label">Recompensa (XP 🌟):</label>
                        <InputNumber @bind-Value="modeloFormulario.Experiencia" class="form-control input-taverna" min="1" />
                    </div>
                </div>

                <div class="form-group">
                    <label class="form-label">Nível Recomendado do Herói:</label>
                    <InputNumber @bind-Value="modeloFormulario.NivelRecomendado" class="form-control input-taverna" min="1" style="max-width: 150px;" />
                </div>

                @if (!string.IsNullOrEmpty(mensagemErro))
                {
                    <div class="mensagem-erro text-center mt-3">
                        <strong>Aviso:</strong> @mensagemErro
                    </div>
                }

                <div class="text-center mt-5">
                    <button type="submit" class="btn-taverna btn-fundar">
                        📌 Afixar no Quadro
                    </button>
                </div>

            </EditForm>
        }
    </div>
</div>

@code {
    private class FormularioMissao
    {
        public string Nome { get; set; } = "";
        public string Descricao { get; set; } = "";
        public decimal Ouro { get; set; } = 100m; 
        public int Experiencia { get; set; } = 50;
        public int NivelRecomendado { get; set; } = 1;
    }

    private FormularioMissao modeloFormulario = new FormularioMissao();
    private bool mostrarSucesso = false;
    private string mensagemErro = "";

    protected async Task SalvarMissao()
    {
        mensagemErro = "";

        // Validações da Taverna
        if (string.IsNullOrWhiteSpace(modeloFormulario.Nome) || string.IsNullOrWhiteSpace(modeloFormulario.Descricao))
        {
            mensagemErro = "A missão precisa de um título e uma descrição clara!";
            return;
        }

        if (modeloFormulario.Ouro <= 0 || modeloFormulario.Experiencia <= 0)
        {
            mensagemErro = "Mercenários não trabalham de graça! As recompensas devem ser positivas.";
            return;
        }

        try
        {
            // Substitua os parâmetros se a ordem no construtor da sua classe Missao for diferente!
            Missao novaMissao = new Missao(
                modeloFormulario.Nome,
                modeloFormulario.Descricao,
                modeloFormulario.Ouro,
                modeloFormulario.Experiencia,
                modeloFormulario.NivelRecomendado
               
            );

            await MissaoService.CriarMissao(novaMissao);

            // Troca o formulário pela mensagem de sucesso!
            mostrarSucesso = true;
        }
        catch (Exception ex)
        {
            mensagemErro = $"Erro ao pregar o contrato: {ex.Message}";
        }
    }
}