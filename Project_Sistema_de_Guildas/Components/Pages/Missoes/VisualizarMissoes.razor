@page "/Missao/Pesquisa"
@using SistemaDeGuildas.Models
@using SistemaDeGuildas.Services

@inject MissaoS MissaoService
@inject IJSRuntime JSRuntime
@rendermode InteractiveServer

<PageTitle>Quadro de Contratos</PageTitle>

<Banner Titulo="Quadro de Contratos" Descricao="Explore todas as missões disponíveis para os heróis da região!" />

<div>
    <div class="search-bar-container">
        <input type="text"
               @bind="pesquisaMissao"
               @bind:event="oninput"
               class="form-control input-pesquisa"
               placeholder="Buscar missão por nome..." />

        <a href="/Missoes/Cadastro" class="btn-acao-lateral">
            ➕ Criar Missão
        </a>
    </div>

    @if (!string.IsNullOrEmpty(mensagemAviso))
    {
        <div class="text-center mb-4 mensagem-aviso">
            <strong>Atenção:</strong> @mensagemAviso
        </div>
    }
    @if (!string.IsNullOrEmpty(mensagemSucesso))
    {
        <div class="text-center mb-4 mensagem-sucesso">
            <strong>Sucesso:</strong> @mensagemSucesso
        </div>
    }

    @if (listaMissoes == null)
    {
        <div class="text-center mt-5">
            <h3 class="texto-destaque-ouro">Aguarde... Os mensageiros estão buscando os registros de missões.</h3>
        </div>
    }
    else if (listaMissoes.Count == 0)
    {
        <div class="text-center mt-5">
            <h3 class="texto-destaque-ouro">Paz pelo nosso mundo! Sem missões no momento.</h3>
        </div>
    }
    else
    {
        <div class="features-grid">
            @foreach (var missao in missoesFiltradas)
            {
                <div class="feature-box cartao-missao">

                    <button class="btn-deletar-cartao" title="Rasgar Contrato"
                            @onclick="() => DeletarMissao(missao.Id)"
                            @onclick:stopPropagation="true">
                        ❌
                    </button>

                    <a href="/Missoes/Detalhes/@missao.Id" class="link-cartao-missao">

                        <div class="feature-icon">📜</div>
                        <h3>@missao.Nome</h3>

                        <p class="descricao-missao">
                            "@missao.Descricao"
                        </p>

                        <p><strong>Ouro:</strong> @missao.OuroRecompensa 💰</p>
                        <p><strong>XP:</strong> @missao.ExperienciaRecompensa 🌟</p>
                        <p><strong>Nível Recomendado:</strong> @missao.NivelRecomendado</p>
                    </a>
                </div>
            }
        </div>

        @if (!missoesFiltradas.Any())
        {
            <div class="text-center mt-4">
                <p class="texto-nenhum-resultado">
                    Nenhuma missão encontrada com o nome "<strong>@pesquisaMissao</strong>".
                </p>
            </div>
        }
    }
</div>

@code {
    private List<Missao> listaMissoes;
    private string pesquisaMissao = "";

    private string mensagemAviso = "";
    private string mensagemSucesso = "";

    private IEnumerable<Missao> missoesFiltradas
    {
        get
        {
            if (string.IsNullOrWhiteSpace(pesquisaMissao))
                return listaMissoes;

            return listaMissoes.Where(m => m.Nome.Contains(pesquisaMissao, StringComparison.OrdinalIgnoreCase));
        }
    }

    protected override async Task OnInitializedAsync()
    {
        listaMissoes = await MissaoService.VerTodasAsMissoes();
    }

    private async Task DeletarMissao(int id)
    {
        mensagemAviso = "";
        mensagemSucesso = "";

        bool confirmado = await JSRuntime.InvokeAsync<bool>("confirm", "Tem certeza que deseja rasgar este contrato e removê-lo do quadro?");

        if (confirmado)
        {
            try
            {
                await MissaoService.ExcluirMissao(id);

                listaMissoes.RemoveAll(m => m.Id == id);
                mensagemSucesso = "Contrato rasgado com sucesso!";

                StateHasChanged();
            }
            catch (Exception ex)
            {
                mensagemAviso = $"Não foi possível remover o contrato: {ex.Message}";
            }
        }
    }
}