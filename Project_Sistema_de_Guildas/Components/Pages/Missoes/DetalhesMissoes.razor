@page "/Missoes/Detalhes/{Id:int}"
@using SistemaDeGuildas.Models
@using SistemaDeGuildas.Services

@inject MissaoS MissaoService
@rendermode InteractiveServer

<PageTitle>Detalhes do Contrato</PageTitle>

@if (missaoDetalhada == null)
{
    <div class="text-center mt-5">
        <h3 class="texto-carregamento">Aguarde... Desenrolando o pergaminho...</h3>
    </div>
}
else
{
    <Banner Titulo="Contrato de Missão" Descricao="Analise os perigos e recompensas antes de assinar com sangue." />

    <div class="container main-content container-detalhes">

        <div class="formulario-card">

            <div class="text-center">
                <h2 class="form-titulo">@missaoDetalhada.Nome</h2>

                <div class="container-status-missao">
                    @if (missaoDetalhada.AventureiroResponsavel == null && missaoDetalhada.GuildaResponsavel == null)
                    {
                        <span class="badge-status status-aberta">
                            🔓 Aberta para Aventureiros ou Guildas
                        </span>
                    }
                    else if (missaoDetalhada.AventureiroResponsavel != null)
                    {
                        <span class="badge-status status-andamento">
                            ⚔️ Em andamento por: @missaoDetalhada.AventureiroResponsavel.Nome
                        </span>
                    }
                    else
                    {
                        <span class="badge-status status-andamento">
                            🚩 Em andamento pela guilda: @missaoDetalhada.GuildaResponsavel.Nome
                        </span>
                    }
                </div>

                <div class="divisor-elegante"></div>
            </div>

            <div class="secao-relato">
                <h4 class="titulo-secao">📜 Relato da Caçada:</h4>
                <p class="texto-relato">
                    "@missaoDetalhada.Descricao"
                </p>
            </div>

            <div class="quadro-recompensas">
                <div class="item-recompensa">
                    <h4 class="titulo-recompensa">💰 Ouro</h4>
                    <span class="valor-ouro">@missaoDetalhada.OuroRecompensa moedas</span>
                </div>

                <div class="item-recompensa">
                    <h4 class="titulo-recompensa">🌟 Experiência</h4>
                    <span class="valor-xp">@missaoDetalhada.ExperienciaRecompensa XP</span>
                </div>

                <div class="item-recompensa">
                    <h4 class="titulo-recompensa">🛡️ Dificuldade</h4>
                    <span class="valor-dificuldade">Nível @missaoDetalhada.NivelRecomendado</span>
                </div>
            </div>

            <div class="mt-5 text-center">
                <a href="/Missao/Pesquisa" class="btn-taverna btn-fundar link-voltar">
                    ⬅️ Voltar ao Quadro
                </a>
            </div>

        </div>
    </div>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private Missao missaoDetalhada;

    protected override async Task OnInitializedAsync()
    {
        missaoDetalhada = await MissaoService.VerMissaoPorId(Id);
    }
}